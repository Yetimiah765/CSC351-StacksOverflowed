SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Poker realtime server (npm run realtime)
POKER_TABLE_MAX_SEATS=6

# The Odds API (https://the-odds-api.com) - free tier is 500 credits/month.
# Each sync costs 5 credits per sport (3 for odds, 2 for scores).
ODDS_API_KEY="your-odds-api-key"
# Comma-separated sport keys from GET /v4/sports. Defaults to americanfootball_nfl.
ODDS_API_SPORTS="americanfootball_nfl"
# Bearer token required by /api/sports/sync.
SPORTS_SYNC_SECRET="choose-a-long-random-string"
