SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Poker: signs player actions relayed by /api/poker/action and seals each
# player's hole cards (lib/pokerSecure.ts). The Next app and the poker
# realtime server (npm run realtime) must use the same value. Never expose it
# to the browser (no NEXT_PUBLIC_ prefix). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POKER_SERVER_SECRET="choose-a-long-random-string"

# The Odds API (https://the-odds-api.com) - free tier is 500 credits/month.
# Each sync costs 3 credits per sport for odds, plus 2 per sport for scores.
ODDS_API_KEY="your-odds-api-key"
# Comma-separated sport keys from GET /v4/sports. Defaults to NFL + NBA.
ODDS_API_SPORTS="americanfootball_nfl,basketball_nba"
# Bearer token required by /api/sports/sync.
SPORTS_SYNC_SECRET="choose-a-long-random-string"
