%% Legend: rounded = people, gold = our system, dashed = external systems
flowchart LR
    player(["👤 <b>Player</b><br/>registered user, 21+<br/>plays, bets, shops"])
    guest(["👤 <b>Unregistered User</b><br/>guest, not logged in"])

    sys["<b>Stacks Overflowed</b><br/>virtual-currency casino<br/><br/>poker · blackjack<br/>roulette · slots<br/>sports betting<br/>cosmetic shop"]

    db["<b>Supabase</b><br/><i>external system</i><br/>accounts, balances,<br/>stats, cosmetics"]
    ai["<b>AI Provider (LLM)</b><br/><i>external system</i><br/>move &amp; bet advice"]
    sports["<b>Sports Odds &amp; Scores API</b><br/><i>external system</i><br/>events, odds, results"]

    player <-- "plays games, wagers coins<br/>&amp; gets live updates" --> sys
    guest -- "browses games<br/>&amp; signs up" --> sys
    sys -- "stores &amp; reads<br/>player data" --> db
    sys -- "asks for<br/>suggestions" --> ai
    sys -- "pulls odds<br/>&amp; results" --> sports

    classDef person fill:#ffffff,stroke:#111,stroke-width:3px,color:#111
    classDef system fill:#f5b400,stroke:#111,stroke-width:4px,color:#111
