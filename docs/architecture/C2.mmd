flowchart LR

    Guest[Guest<br/>views home page & available games]
    Player[Player<br/>plays games, sports bets, manages profile]

    subgraph SO["Stacks Overflowed (our system)"]
        Web["Web App<br/>(browser UI)<br/><br/>home, profile, shop,<br/>games, sports betting"]
        API["API Server<br/>(REST / JSON + JWT)<br/>+ Game Logic<br/><br/>accounts, profile, balance,<br/>cosmetics, wagering,<br/>roulette, slots, blackjack,<br/>game rules & state coordination"]
        PokerServer["Poker Realtime Server<br/>(Node process)<br/><br/>authoritative in-memory<br/>poker table state,<br/>turn timers, validates<br/>session tokens"]

        Web -->|"calls<br/>JSON + JWT"| API
        API <-->|"validates session /<br/>coordinates state"| PokerServer
        API -->|"game events /<br/>state updates"| PokerServer
    end

    Guest -->|"uses"| Web
    Player -->|"uses"| Web

    subgraph SUPA["Supabase (hosted cloud)"]
        DB["Database<br/>(PostgreSQL)<br/><br/>accounts, balances,<br/>wagers, game history"]
        Auth["Auth<br/>(Supabase Auth)<br/><br/>logins & tokens"]
        Storage["Storage<br/>(Supabase Storage)<br/><br/>profile photos & cosmetic images"]
        Realtime["Realtime<br/>(Broadcast + Presence)<br/><br/>relays live poker table state<br/>between Web and PokerServer"]
    end

    Web -->|"connects<br/>(outbound WS)"| Realtime
    PokerServer -->|"connects<br/>(outbound WS)"| Realtime

    Odds["Sports Odds API<br/><br/>events, odds, scores"]
    AI["AI Provider<br/><br/>ChatGPT / Claude / Gemini"]

    API -->|"reads / writes"| DB
    API -->|"checks logins"| Auth
    API -->|"uploads / reads<br/>images"| Storage
    API -->|"fetches<br/>sports data"| Odds
    API -->|"gets betting<br/>suggestions"| AI
    API -->|"gets blackjack<br/>suggestions"| AI
